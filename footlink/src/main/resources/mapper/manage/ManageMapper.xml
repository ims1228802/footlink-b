<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.footlink.footlink.user.manage.mapper.ManageMapper">

	<!-- 유저 회원가입 매핑 -->
	<resultMap
		type="com.footlink.footlink.user.manage.domain.SignUpRequest"
		id="userResultMap">
		<id column="user_id" property="id" />
		<result column="user_email" property="email" />
		<result column="user_pw" property="password" />
		<result column="user_phn_num" property="phone" />
		<result column="user_birth" property="birth" />
		<result column="user_gender" property="gender" />
		<result column="user_addr" property="addr" />
		<result column="user_nm" property="name" />
	</resultMap>

	<!-- 인증번호 매핑 -->
	<resultMap
		type="com.footlink.footlink.user.manage.domain.VerificationRequest"
		id="verificationResultMap">
		<id column="id" property="id" />
		<result column="phone" property="phone" />
		<result column="code" property="code" />
		<result column="expire_time" property="expireTime" />
		<result column="created_at" property="createdAt" />
	</resultMap>

	<!-- 휴대폰 번호 중복 여부 확인 -->
	<select id="existsByPhone" parameterType="string"
		resultType="boolean">
		SELECT EXISTS (
		SELECT *
		FROM `user`
		WHERE user_phn_num =
		#{phone}
		)
	</select>

	<!-- 인증번호 저장 -->
	<insert id="save"
		parameterType="com.footlink.footlink.user.manage.domain.VerificationRequest">
		INSERT INTO verification_codes
		(id, phone, code,
		expire_time, created_at)
		VALUES
		(#{id}, #{phone}, #{code},
		#{expireTime}, NOW())
	</insert>

	<!-- 최근 인증번호 조회 -->
	<select id="findTopByPhoneOrderByCreatedAtDesc"
		parameterType="string" resultMap="verificationResultMap">
		SELECT *
		FROM verification_codes
		WHERE
		phone = #{phone}
		ORDER BY created_at DESC
		LIMIT 1
	</select>

	<!-- 유저 회원가입 -->
	<insert id="signUp"
		parameterType="com.footlink.footlink.user.manage.domain.User">
		INSERT INTO `user`
		(user_id, user_email, user_pw, user_phn_num, user_birth, user_gender,
		user_addr, user_nm)
		VALUES
		(#{id}, #{email}, #{password}, #{phone}, #{birth}, #{gender}, #{addr},
		#{name})
	</insert>

</mapper>