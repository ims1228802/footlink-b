<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  <mapper namespace="com.footlink.footlink.user.manage.mapper.ManageMapper">
  	<resultMap type="com.footlink.footlink.user.manage.domain.SignUpRequest" id="userResultMap">
		<id column="user_id" 						property="id" />
		<result column="user_email" 				property="email" />
		<result column="user_pw" 					property="password" />
		<result column="user_phn_num" 				property="phone" />
		<result column="user_birth" 				property="birth" />
		<result column="user_gender" 				property="gender" />
		<result column="user_addr" 					property="addr" />
		<result column="user_nm" 					property="name" />
	</resultMap>
  
    <!-- 휴대폰 번호 중복 여부 확인 -->
    <select id="existsByPhone" parameterType="string" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM user
            WHERE user_phn_num = #{phone}
            )
    </select>
  </mapper>